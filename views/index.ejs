<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manjah Store</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<canvas id="particles"></canvas>

<div class="lightning lightning-a"></div>
<div class="lightning lightning-b"></div>

<nav class="navbar">
  <div class="logo-area">
    <img src="/logo.png" class="logo-img">
    <div>
      <h2>MANJAH <span>STORE</span></h2>
      <small>Premium Digital Market</small>
    </div>
  </div>

  <div class="nav-links">
    <a href="#">Home</a>
    <a href="#products">Produk</a>
    <a href="#stats">Stats</a>
    <a href="#footer">Kontak</a>
  </div>

  <a href="https://discord.gg/" class="discord-btn">Join Discord</a>
</nav>

<section class="hero">
  <div class="floating icon1">💬</div>
  <div class="floating icon2">🎧</div>
  <div class="floating icon3">💎</div>
  <div class="floating icon4">👑</div>

  <div class="hero-content">
    <div class="badge">⚡ AUTO DELIVERY MARKETPLACE</div>

    <h1>MANJAH <span>STORE</span></h1>

    <p>Digital Product • Discord Service • Premium App • Auto Delivery</p>

    <div class="hero-features">
      <span>⚡ Instant Delivery</span>
      <span>🛡️ Trusted Store</span>
      <span>🎧 24/7 Support</span>
      <span>💎 Premium Quality</span>
    </div>

    <div class="hero-buttons">
      <a href="https://discord.gg/" class="btn primary">Join Discord</a>
      <a href="#products" class="btn secondary">Lihat Produk</a>
    </div>
  </div>
</section>

<section class="stats" id="stats">
  <div class="stat-card">
    <h3><%= stats.totalProducts %></h3>
    <p>Total Produk</p>
  </div>

  <div class="stat-card">
    <h3><%= stats.totalStock %></h3>
    <p>Stock Tersedia</p>
  </div>

  <div class="stat-card">
    <h3><%= stats.success %></h3>
    <p>Transaksi Sukses</p>
  </div>

  <div class="stat-card">
    <h3>Rp <%= Number(stats.revenue || 0).toLocaleString('id-ID') %></h3>
    <p>Total Revenue</p>
  </div>
</section>

<section class="marketplace" id="products">

  <main>
    <div class="section-head">
      <div>
        <h2>🔥 Product Slider</h2>
        <p>Live stock dari Server Manjah Store & auto sync dengan bot Manjah Store.</p>
      </div>
    </div>

    <div class="product-tools">
      <input type="text" id="searchInput" placeholder="Cari produk...">

      <select id="categoryFilter">
        <option value="all">Semua Kategori</option>
        <% [...new Set(products.map(p => p.category))].forEach(category => { %>
          <option value="<%= category %>"><%= category %></option>
        <% }) %>
      </select>
    </div>

    <div class="slider">
      <% products.slice(0, 8).forEach(product => { %>
        <div
          class="slide-card product-item"
          data-name="<%= (product.name || '').toLowerCase() %>"
          data-category="<%= product.category %>"
        >
          <% if (product.sold >= 1) { %>
            <span class="hot">HOT</span>
          <% } %>

          <div class="product-icon">
            <% if ((product.name || '').toLowerCase().includes('spotify')) { %>
              🎧
            <% } else if ((product.name || '').toLowerCase().includes('nitro')) { %>
              💎
            <% } else if ((product.name || '').toLowerCase().includes('netflix')) { %>
              🎬
            <% } else if ((product.name || '').toLowerCase().includes('boost')) { %>
              🚀
            <% } else { %>
              🛒
            <% } %>
          </div>

          <h3><%= product.name %></h3>
          <p><%= product.description || 'Premium digital product.' %></p>

          <div class="price">
            Rp <%= Number(product.price || 0).toLocaleString('id-ID') %>
          </div>

          <% if (product.stock > 0) { %>
            <span class="stock ready">● Stock <%= product.stock %></span>
          <% } else { %>
            <span class="stock empty">● Habis</span>
          <% } %>

          <button
            type="button"
            class="order-btn detail-btn"
            data-name="<%= product.name %>"
            data-price="Rp <%= Number(product.price || 0).toLocaleString('id-ID') %>"
            data-stock="<%= product.stock %>"
            data-desc="<%= product.description || 'Premium digital product.' %>"
          >
            Order Sekarang
          </button>
        </div>
      <% }) %>
    </div>

    <div class="section-head second">
      <div>
        <h2>🛍️ Semua Produk</h2>
        <p>Produk aktif yang tersedia di database.</p>
      </div>
    </div>

    <div class="grid">
      <% products.forEach(product => { %>
        <div
          class="card product-item"
          data-name="<%= (product.name || '').toLowerCase() %>"
          data-category="<%= product.category %>"
        >
          <div class="card-top">
            <span class="category"><%= product.category %></span>

            <% if (product.sold >= 1) { %>
              <span class="hot-badge">🔥 Hot</span>
            <% } else { %>
              <span class="hot-badge normal">New</span>
            <% } %>
          </div>

          <h3><%= product.name %></h3>
          <p><%= product.description || 'Premium digital product.' %></p>

          <h4>Rp <%= Number(product.price || 0).toLocaleString('id-ID') %></h4>

          <div class="card-bottom">
            <% if (product.stock > 0) { %>
              <span class="stock ready">Ready: <%= product.stock %></span>
            <% } else { %>
              <span class="stock empty">Habis</span>
            <% } %>

            <button
              type="button"
              class="cart detail-btn"
              data-name="<%= product.name %>"
              data-price="Rp <%= Number(product.price || 0).toLocaleString('id-ID') %>"
              data-stock="<%= product.stock %>"
              data-desc="<%= product.description || 'Premium digital product.' %>"
            >
              🛒
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <aside class="sidebar">
    <div class="side-card">
      <h3>🏆 Top Seller</h3>

      <% if (topProducts.length) { %>
        <% topProducts.forEach((product, index) => { %>
          <div class="top-item">
            <span>#<%= index + 1 %></span>
            <div>
              <b><%= product.name %></b>
              <p><%= product.sold %> sold</p>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>Belum ada transaksi.</p>
      <% } %>
    </div>

    <div class="side-card">
      <h3>⚡ Store Status</h3>
      <p>Auto Delivery: <b class="green">Online</b></p>
      <p>Database: <b class="green">Connected</b></p>
      <p>Support: <b class="green">Available</b></p>
    </div>
  </aside>

</section>

<section class="features-section">
  <div class="feature">
    <div>🚀</div>
    <h3>Instant Delivery</h3>
    <p>Produk otomatis dikirim lewat bot setelah payment diterima.</p>
  </div>

  <div class="feature">
    <div>🛡️</div>
    <h3>Trusted System</h3>
    <p>Invoice, stock, dan transaksi tercatat otomatis di database.</p>
  </div>

  <div class="feature">
    <div>🎧</div>
    <h3>Fast Support</h3>
    <p>Ticket Discord langsung dibuat untuk order dan bantuan.</p>
  </div>

  <div class="feature">
    <div>💎</div>
    <h3>Premium UI</h3>
    <p>Store modern dengan cyberpunk neon marketplace style.</p>
  </div>
</section>

<footer class="footer" id="footer">
  <div>
    <h2>MANJAH <span>STORE</span></h2>
    <p>Premium digital marketplace dengan auto delivery system.</p>
  </div>

  <div>
    <h4>Menu</h4>
    <a href="#">Home</a>
    <a href="#products">Produk</a>
    <a href="#stats">Stats</a>
  </div>

  <div>
    <h4>Order</h4>
    <a href="https://discord.gg/">Discord</a>
    <a href="#">Ticket System</a>
    <a href="#">Auto Delivery</a>
  </div>
</footer>

<div class="modal" id="productModal">
  <div class="modal-box">
    <button class="modal-close" id="modalClose">×</button>

    <h2 id="modalName"></h2>
    <p id="modalDesc"></p>

    <div class="modal-info">
      <span id="modalPrice"></span>
      <span id="modalStock"></span>
    </div>

    <a href="https://discord.gg/" class="modal-order">
      Order via Discord
    </a>
  </div>
</div>

<script src="/particles.js"></script>

<script>
  const searchInput = document.getElementById('searchInput');
  const categoryFilter = document.getElementById('categoryFilter');
  const productItems = document.querySelectorAll('.product-item');

  function filterProducts() {
    const search = searchInput.value.toLowerCase();
    const category = categoryFilter.value;

    productItems.forEach(product => {
      const name = product.dataset.name || '';
      const productCategory = product.dataset.category || '';

      const matchSearch = name.includes(search);
      const matchCategory = category === 'all' || productCategory === category;

      product.style.display = matchSearch && matchCategory ? '' : 'none';
    });
  }

  searchInput.addEventListener('input', filterProducts);
  categoryFilter.addEventListener('change', filterProducts);

  const modal = document.getElementById('productModal');
  const modalClose = document.getElementById('modalClose');

  document.querySelectorAll('.detail-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('modalName').textContent = btn.dataset.name;
      document.getElementById('modalDesc').textContent = btn.dataset.desc;
      document.getElementById('modalPrice').textContent = btn.dataset.price;

      document.getElementById('modalStock').textContent =
        Number(btn.dataset.stock) > 0
          ? `Stock: ${btn.dataset.stock}`
          : 'Stock Habis';

      modal.classList.add('show');
    });
  });

  modalClose.addEventListener('click', () => {
    modal.classList.remove('show');
  });

  modal.addEventListener('click', e => {
    if (e.target === modal) modal.classList.remove('show');
  });
</script>

</body>
</html>