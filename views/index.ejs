<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manjah Store</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<canvas id="particles"></canvas>

<div class="app">

  <aside class="sidebar">
    <div class="big-logo-card">
      <img src="/logo.png" alt="Manjah Store">
    </div>

    <h3 class="side-title">LOGO MANJAH STORE</h3>

    <div class="file-buttons">
      <button>PNG</button>
      <button>透明</button>
      <button>SVG</button>
      <button>JPG</button>
    </div>

    <div class="side-box">
      <h3>🔥 TOP SELLER</h3>

      <% if (topProducts.length) { %>
        <% topProducts.slice(0,3).forEach(product => { %>
          <div class="side-product">
            <div class="mini-icon">
              <% if ((product.name || '').toLowerCase().includes('spotify')) { %>🎧
              <% } else if ((product.name || '').toLowerCase().includes('nitro')) { %>💎
              <% } else if ((product.name || '').toLowerCase().includes('netflix')) { %>🎬
              <% } else { %>🛒<% } %>
            </div>
            <div>
              <b><%= product.name %></b>
              <p><%= product.sold %>+ terjual</p>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted">Belum ada transaksi.</p>
      <% } %>
    </div>

    <div class="side-box">
      <h3>💎 TRUSTED STORE</h3>
      <p>✅ 100% Aman & Terpercaya</p>
      <p>✅ Pengiriman Otomatis</p>
      <p>✅ Garansi Produk</p>
      <p>✅ Support 24/7</p>
    </div>

    <p class="copyright">© 2026 Manjah Store. All Rights Reserved.</p>
  </aside>

  <main class="main">

    <nav class="topbar">
      <div class="brand">
        <img src="/logo.png">
        <div>
          <h2>MANJAH <span>STORE</span></h2>
        </div>
      </div>

      <div class="nav-links">
        <a class="active" href="#">Home</a>
        <a href="#products">Produk</a>
        <a href="#features">Kategori</a>
        <a href="#footer">Cara Order</a>
        <a href="#footer">Testimoni</a>
        <a href="#footer">FAQ</a>
      </div>

      <a href="https://discord.gg/" class="join-btn">🎮 Join Discord</a>
    </nav>

    <section class="hero">
      <div class="floating f1">💬</div>
      <div class="floating f2">🎧</div>
      <div class="floating f3">💎</div>
      <div class="floating f4">👑</div>
      <div class="floating f5">NITRO</div>

      <div class="badge">✨ PREMIUM DIGITAL MARKETPLACE</div>

      <h1>MANJAH<br><span>STORE</span></h1>

      <p>Digital Product • Discord Service • <b>Auto Delivery</b></p>

      <div class="hero-tags">
        <span>⚡ Instant Delivery<br><small>1-5 Menit</small></span>
        <span>🛡️ 100% Trusted<br><small>Aman & Terpercaya</small></span>
        <span>🎧 24/7 Support<br><small>Siap Membantu</small></span>
        <span>💎 Premium Quality<br><small>Produk Berkualitas</small></span>
      </div>

      <div class="hero-buttons">
        <a href="https://discord.gg/" class="btn primary">🎮 Join Discord</a>
        <a href="#products" class="btn secondary">Lihat Produk ↓</a>
      </div>
    </section>

    <section class="stats">
      <div>
        <h3>🛍️ <%= stats.totalStock %>+</h3>
        <p>Stock Tersedia</p>
      </div>
      <div>
        <h3>👥 <%= stats.success %>+</h3>
        <p>Transaksi Sukses</p>
      </div>
      <div>
        <h3>🛡️ 99.9%</h3>
        <p>Uptime Layanan</p>
      </div>
      <div>
        <h3>⭐ 4.9/5</h3>
        <p>Rating Pelanggan</p>
      </div>
    </section>

    <section class="products" id="products">
      <div class="section-head">
        <h2>📦 PRODUK TERSEDIA</h2>
        <button>▦ Semua Kategori⌄</button>
      </div>

      <div class="product-row">
        <% products.slice(0,4).forEach(product => { %>
          <div class="product-card">
            <% if (product.sold >= 1) { %>
              <span class="hot">HOT</span>
            <% } %>

            <div class="product-icon">
              <% if ((product.name || '').toLowerCase().includes('spotify')) { %>🎧
              <% } else if ((product.name || '').toLowerCase().includes('nitro')) { %>💎
              <% } else if ((product.name || '').toLowerCase().includes('netflix')) { %>🎬
              <% } else if ((product.name || '').toLowerCase().includes('telegram')) { %>💠
              <% } else { %>🛒<% } %>
            </div>

            <span class="category"><%= product.category %></span>

            <h3><%= product.name %></h3>
            <p><%= product.description || 'Produk premium full garansi' %></p>

            <h4>Rp <%= Number(product.price || 0).toLocaleString('id-ID') %></h4>

            <div class="bottom">
              <% if (product.stock > 0) { %>
                <span class="stock ready">● Stok: <%= product.stock %></span>
              <% } else { %>
                <span class="stock empty">● Habis</span>
              <% } %>
            </div>

            <a class="order" href="https://discord.gg/">🎮 Order via Discord</a>
          </div>
        <% }) %>
      </div>

      <a href="#products" class="see-all">Lihat Semua Produk →</a>
    </section>

    <section class="features" id="features">
      <div>
        <h3>⚡ Pengiriman Otomatis</h3>
        <p>Produk dikirim otomatis setelah pembayaran.</p>
      </div>
      <div>
        <h3>🛡️ Aman & Terpercaya</h3>
        <p>Transaksi aman dengan sistem terenkripsi.</p>
      </div>
      <div>
        <h3>🎧 Support 24/7</h3>
        <p>Tim support siap membantu kapan saja.</p>
      </div>
      <div>
        <h3>💎 Garansi Produk</h3>
        <p>Semua produk bergaransi penuh.</p>
      </div>
    </section>

  </main>

</div>

<script src="/particles.js"></script>
</body>
</html>